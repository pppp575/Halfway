# Copy to .env for local development. Never commit .env.
# All of these are optional: without Supabase the game runs with local stats only.

# Your site's public address, without a trailing slash (used for share links and social tags).
VITE_SITE_URL=

# Supabase: Project Settings > API Keys. The publishable key (sb_publishable_...) or the legacy anon key.
# It is safe to ship to browsers; the database only allows the functions in supabase/schema.sql.
# Never put the secret or service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Google AdSense (optional): your publisher id (ca-pub-...) and two ad unit slot ids.
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_ROUND=
VITE_ADSENSE_SLOT_DONE=

# Base path. "/" for a custom domain or <user>.github.io; "/<repo>/" for a project page.
# The deploy workflow sets this for you.
VITE_BASE=/
